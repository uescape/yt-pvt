{
  "name": "curato",
  "private": true,
  "description": "Filtered, personalized YouTube for TVs and phones: block channels, allow-only lists, hide Shorts, kids profiles.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@curato/mobile run build",
    "test": "pnpm -r --filter=!@curato/mobile run test",
    "typecheck": "pnpm -r run typecheck",
    "dev:api": "pnpm --filter @curato/api dev",
    "dev:tv": "pnpm --filter @curato/tv dev",
    "dev:mobile": "pnpm --filter @curato/mobile start",
    "icons": "node scripts/generate-icons.cjs",
    "package:tizen": "node platforms/scripts/package-launcher.mjs tizen",
    "package:webos": "node platforms/scripts/package-launcher.mjs webos"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
